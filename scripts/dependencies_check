dependencies_check() {
    local dependency tool package
    local missing=()
    while read -r dependency || [[ -n "$dependency" ]]; do
        [[ -z "$dependency" || "$dependency" == \#* ]] && continue
        tool=${dependency%%:*}
        package=${dependency#*:}
        if [[ "$tool" == /* ]]; then
            [[ -e "$tool" ]] || missing+=("$package")
        elif ! command -v "$tool" >/dev/null; then
            missing+=("$package")
        fi
    done < "$1"
    if ((${#missing[@]})); then
        printf 'Missing build dependencies. Install with:\n  sudo apt install %s\n' "${missing[*]}" >&2
        return 1
    fi
}
